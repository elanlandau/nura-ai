# Copy to .env and replace with your values. Never commit .env.

# ── NextAuth ────────────────────────────────────────────────────────────────────
# Generate secret: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# ── Google OAuth ─────────────────────────────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ── Microsoft (Azure AD) OAuth ────────────────────────────────────────────────────
# https://portal.azure.com → App registrations → New registration
# Redirect URI: http://localhost:3000/api/auth/callback/azure-ad
MICROSOFT_CLIENT_ID=your-azure-client-id
MICROSOFT_CLIENT_SECRET=your-azure-client-secret
# Leave as 'common' for multi-tenant, or set to your tenant ID for single-tenant
MICROSOFT_TENANT_ID=common

# ── Supabase (database only — Supabase auth is NOT used) ─────────────────────────
# From Supabase project Settings → API
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ── Prisma / PostgreSQL ───────────────────────────────────────────────────────────
# From Supabase: Settings → Database → Connection string (URI mode for pooler, Direct for migrations)
DATABASE_URL=postgresql://user:password@host:5432/database?pgbouncer=true
# Direct connection for migrations/db push (no pgbouncer)
DIRECT_URL=postgresql://user:password@host:5432/database

# ── OpenAI ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Resend (transactional email) ──────────────────────────────────────────────────
# https://resend.com → API Keys → Create API Key
RESEND_API_KEY=re_your-resend-api-key-here
# Verified sender address from your Resend domain
RESEND_FROM_EMAIL=NURA <noreply@nurapersonal.com>

# ── Web Push (optional) ──────────────────────────────────────────────────────────
# Generate keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# ── Cron (optional) ──────────────────────────────────────────────────────────────
CRON_SECRET=your-cron-secret-here

# ── Optional: Gmail push filter ───────────────────────────────────────────────────
# IMPORTANT_SENDER_EMAILS=client@company.com,boss@work.com
# IMPORTANT_SENDER_DOMAINS=company.com,client.org
