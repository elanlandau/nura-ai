// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Auth: NextAuth via @auth/prisma-adapter (User, Account, Session, VerificationToken).
// App tables: MeetingThread, ChatMessage, UserChatProfile, Task, EmailPushSent, PushSubscription.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

// ─── NextAuth models ───────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  @@schema("public")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("public")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("public")
}

model OAuthAccount {
  id                   String   @id @default(cuid())
  user_id              String
  provider             String   // 'google' | 'microsoft'
  provider_account_id  String
  access_token         String?
  refresh_token        String?
  expires_at           Int?     // Unix seconds
  token_type           String?
  scope                String?
  email                String?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@schema("public")
  @@unique([user_id, provider])
}

model MeetingThread {
  id                 String   @id @default(cuid())
  user_id            String
  recipient_email    String
  recipient_name     String?
  subject            String
  proposed_slots     String   // JSON array of TimeSlot
  selected_slot      String?  // JSON TimeSlot or null
  status             String   // 'proposed' | 'confirmed' | 'cancelled'
  email_thread_id    String?
  calendar_event_id  String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@schema("public")
}

/** Cross-thread memory: name + preference bullets shown in every chat system prompt (new threads included). */
model UserChatProfile {
  user_id               String   @id // Supabase auth user id
  display_name          String? // e.g. "Elan" — shown in prompts; synced from auth if empty
  preferences_summary   String?  @db.Text // newline-separated bullets, e.g. "Hebrew-first\nMorning meetings"
  onboarding_completed  Boolean  @default(false) // interactive onboarding chat finished
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@schema("public")
  @@map("user_chat_profile")
}

model ChatThread {
  id        String   @id @default(cuid())
  user_id   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  messages  ChatMessage[]

  @@schema("public")
}

model ChatMessage {
  id        String   @id @default(cuid())
  thread_id String?  // null = legacy message (pre-threads)
  user_id   String
  role      String   // 'user' | 'assistant' | 'system'
  content   String
  created_at DateTime @default(now())
  thread    ChatThread? @relation(fields: [thread_id], references: [id], onDelete: Cascade)

  @@schema("public")
}

model PushSubscription {
  id        String   @id @default(cuid())
  user_id   String
  endpoint  String   @unique
  p256dh    String   // public key for encryption
  auth      String   // auth secret
  created_at DateTime @default(now())

  @@schema("public")
  @@map("push_subscription")
}

model Task {
  id             String    @id @default(cuid())
  user_id        String
  title          String
  due_at         DateTime  // Due date/time for Task Pop
  alert_sent_at  DateTime?  // Set when we sent "due now" push so we don't repeat
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@schema("public")
  @@map("task")
}

model EmailPushSent {
  id         String   @id @default(cuid())
  user_id    String
  message_id String   // Gmail message id
  created_at DateTime @default(now())

  @@schema("public")
  @@unique([user_id, message_id])
  @@map("email_push_sent")
}
